{
  "name": "x-pt-filter",
  "version": "1.0.0",
  "description": "Browser extension that removes Portuguese-language posts from X (Twitter) timelines.",
  "license": "MIT",
  "author": "Leonardo Araujo",
  "homepage": "https://github.com/leo-aa88/x-pt-filter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo-aa88/x-pt-filter.git"
  },
  "bugs": {
    "url": "https://github.com/leo-aa88/x-pt-filter/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "manifest-v3",
    "twitter",
    "x"
  ],
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs all --zip",
    "build:unpacked": "node scripts/build.mjs all",
    "test": "node --test",
    "lint": "eslint . && prettier --check .",
    "lint:ext": "npm run build:unpacked && web-ext lint --source-dir dist/firefox",
    "format": "prettier --write .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "web-ext": "^10.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
